# JEAD Research Portal — 環境変数テンプレート
# 実際の値は絶対にこのファイルに書かず、ローカル開発では .env.local
# （.gitignore対象）に、本番環境ではVercelの環境変数設定に登録すること。

# Resend APIキー（resend.com/api-keys で発行）
RESEND_API_KEY=

# 登録フォームの通知先（JEAD研究事務局）
JEAD_NOTIFICATION_EMAIL=info@everlink-el.jp

# 送信元表示。ドメイン未認証の間は Resend のデフォルトドメインを使用する。
# everlink-el.jp のドメイン認証が完了したら、コード変更不要で以下に切り替え可能：
# JEAD_FROM_EMAIL=JEAD Research Office <research@everlink-el.jp>
JEAD_FROM_EMAIL=JEAD Research Office <onboarding@resend.dev>
